{
  "name": "albion-market-table",
  "version": "1.0.0",
  "description": "Таблица цен предметов Albion Online по всем городам для спекуляции и закупки под крафт",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "audit:craft": "vitest run --config vitest.audit.config.js",
    "audit:craft:e2e": "playwright test --config playwright.audit.config.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "supertest": "^7.2.2",
    "vitest": "^5.0.1"
  }
}
